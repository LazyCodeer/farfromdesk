{
  "name": "farfromdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc && node script/package_social_skill.mjs",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "bridge": "node dist/cli.js",
    "test": "node script/run_node_tests.mjs all",
    "check": "tsc --noEmit",
    "test:portable": "node script/run_node_tests.mjs portable",
    "test:file": "node script/run_node_tests.mjs files",
    "desktop:backend": "npm run build && node script/prepare_desktop_backend.mjs",
    "desktop:preview": "cd desktop && flutter run -d chrome -t lib/preview.dart",
    "evals": "tsx script/run_brain_evals.mts",
    "evals:live": "node script/live_transcript.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.68",
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "ai": "7.0.139",
    "ipaddr.js": "^2.5.0",
    "livekit-client": "2.15.6",
    "livekit-server-sdk": "2.19.2",
    "mailparser": "^3.14.1",
    "parse5": "7.3.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "sharp": "0.35.5",
    "werift": "0.25.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "description": "Your coding sessions, one WhatsApp message away.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LazyCodeer/farfromdesk.git"
  },
  "homepage": "https://ffd.codecylabs.com"
}
